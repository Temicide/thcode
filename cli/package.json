{
  "name": "thcode",
  "version": "0.1.0",
  "description": "Thai-first coding agent CLI (headless core + Ink terminal UI). Competition prototype scaffold.",
  "type": "module",
  "bin": {
    "thcode": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "catalog-manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "thai",
    "coding-agent",
    "cli",
    "ink",
    "typhoon",
    "ai-for-thai"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
